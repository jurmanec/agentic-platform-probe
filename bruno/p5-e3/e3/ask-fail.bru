meta {
  name: Ask (fail path)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/ask
  body: json
  auth: none
}

body:json {
  {
    "query": "What is the 2099 lunar billboard advertising budget for AcmeCorp?",
    "idempotency_key": "demo-fail-001"
  }
}

docs {
  Out-of-corpus request from docs/E3.md API contract.
  Expect status unknown, no invented facts, and citations empty or minimal.
  Result is still cached under the idempotency key (unknown is a valid cached outcome).
}
